<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Escuta de "Ei Vênus" com o app fechado -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Mostrar o orbe por cima de outros apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Necessário a partir do Android 11 para ver os apps instalados, a voz e a fala -->
    <queries>
        <!-- para saber se o Vênus Robô está instalado e em qual versão (atualização pela Vênus) -->
        <package android:name="com.tonimarques.venusrobo" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Só apps assinados com a mesma chave (o Vênus Robô) leem as regras de venda -->
    <permission
        android:name="com.tonimarques.sextafeira.permission.LER_REGRAS"
        android:protectionLevel="signature" />

    <application
        android:name=".VenusApp"
        android:largeHeap="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_antigo"
        android:dataExtractionRules="@xml/backup"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Tema">

        <!-- Trava de segurança: Vetorial ID + licença antes de abrir a Vênus -->
        <activity
            android:name=".TravaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Receber fotos pelo "Compartilhar" (nota de compra, trocar fundo, cadastrar produto) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Receber várias fotos ou arquivos de uma vez -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <!-- Receber arquivos (PDF, áudios, Word, Excel, textos) para ler e conversar sobre eles -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.ms-excel" />
            </intent-filter>
            <!-- "Abrir com Vênus" -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/atalhos" />
        </activity>

        <!-- Sessão entre apps da Vetorial Tech no mesmo celular (Vindex, Vortex, portais): só pacotes da suíte, com confirmação -->
        <activity
            android:name=".AcessoDeAppsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:theme="@style/Tema.Dialogo">
            <intent-filter>
                <action android:name="tech.vetorial.id.ENTRAR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- O pop-up do orbe, na parte de baixo da tela -->
        <activity
            android:name=".PopupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.tonimarques.sextafeira.popup"
            android:theme="@style/Tema.Popup">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Baixa o recorte de fotos do Google junto com o app -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <!-- As regras de venda para o Vênus Robô (somente leitura, mesma assinatura) -->
        <!-- Vênus Robô (agora parte da Vênus): tela, respostas prontas do Instagram e o ouvido das notificações -->
        <!-- singleTask + venus-tap://resultado: o app da InfinitePay devolve o resultado do cartão por aproximação (InfiniteTap) para o Caixa já aberto. Só vale se o order_id for o da venda em andamento. -->
        <activity android:name=".CaixaActivity" android:exported="true" android:launchMode="singleTask" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="venus-tap" android:host="resultado" />
            </intent-filter>
        </activity>
        <activity android:name=".robo.TelaRobo" android:exported="false" />
        <activity android:name=".robo.TelaRespostas" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".robo.OuvinteRobo"
            android:exported="true"
            android:label="Vênus (Robô de atendimento)"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name=".ProvedorDeRegras"
            android:authorities="com.tonimarques.sextafeira.regras"
            android:exported="true"
            android:readPermission="com.tonimarques.sextafeira.permission.LER_REGRAS"
            android:writePermission="com.tonimarques.sextafeira.permission.LER_REGRAS" />

        <!-- Onde a câmera salva a foto do produto novo -->
        <provider
            android:name=".FotoProvider"
            android:authorities="com.tonimarques.sextafeira.fotos"
            android:exported="false"
            android:grantUriPermissions="true" />


        <!-- Posts programados do Instagram -->
        <receiver
            android:name=".AvisoDePost"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Caderninho do Caixa: aviso no dia em que o cliente combinou de pagar -->
        <receiver
            android:name=".AvisoDoCaderninho"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Estudo diário da Vênus (memória vetorial) -->
        <service
            android:name=".EstudoDiario"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".PublicadorDePosts"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Stories do dia (dica ou curiosidade de manhã e à tarde) -->
        <receiver
            android:name=".AlarmeDoStory"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".PublicadorDeStory"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Lembretes: dispara na hora marcada e reagenda depois de reiniciar o celular ou atualizar o app -->
        <receiver
            android:name=".AvisoDeLembrete"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Pedidos da página Publicações do site: confere a cada 2 minutos -->
        <receiver
            android:name=".AlarmeDosPedidos"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Cobranças por link (loja sem site): confere a cada 2 minutos enquanto houver link aberto -->
        <receiver
            android:name=".AlarmeDasCobrancas"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Avisos da loja: olha pedidos e estoque de tempos em tempos -->
        <service
            android:name=".VigiaDaLoja"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".VigiliaService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Assistente padrão do celular (segurar o botão de início) -->
        <service
            android:name=".VenusAssistenteService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/assistente" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".VenusSessaoService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <service
            android:name=".VenusReconhecimentoService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/reconhecimento" />
        </service>
    </application>
</manifest>
