{
  "name": "Vênus (Android + web)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "17", "installGradle": false },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["fwcd.kotlin", "vscjava.vscode-gradle", "dbaeumer.vscode-eslint"],
      "settings": { "editor.formatOnSave": false }
    }
  },
  "hostRequirements": { "cpus": 4 }
}
